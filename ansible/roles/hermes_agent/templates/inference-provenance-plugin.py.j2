"""Managed response provenance for the locked-down PiServ Hermes profile."""

import datetime as dt
import json
import os
import pathlib
import uuid


def _route_reason(model: str) -> str:
    if model == "gpt-5.6-luna":
        return "configured_default"
    if model in {"gpt-5.3-codex-spark", "gpt-5.6-terra", "gpt-5.6-sol"}:
        return "fallback_or_operator_selection"
    return "runtime_selection"


def _append_audit(record: dict) -> None:
    hermes_home = pathlib.Path(os.environ.get("HERMES_HOME", "~/.hermes")).expanduser()
    audit_path = hermes_home / "audit" / "inference.jsonl"
    audit_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    encoded = (json.dumps(record, separators=(",", ":"), sort_keys=True) + "\n").encode()
    fd = os.open(audit_path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        os.write(fd, encoded)
    finally:
        os.close(fd)


def add_provenance(response_text: str, session_id: str, model: str, platform: str, **_kwargs):
    if not response_text:
        return None

    record = {
        "data_classification": "not_classified",
        "event_id": str(uuid.uuid4()),
        "model": model or "unknown",
        "outcome": "response_delivered",
        "platform": platform or "unknown",
        "provider": "openai-codex",
        "request_id": session_id or "unavailable",
        "route_reason": _route_reason(model),
        "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
    }
    try:
        _append_audit(record)
    except OSError:
        return None
    return f"{response_text}\n\n[Inference: Codex via ChatGPT Pro, {model or 'unknown model'}]"


def register(ctx):
    ctx.register_hook("transform_llm_output", add_provenance)
