#!/bin/sh
set -eu

install_dir=""
commit=""
hermes_home=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dir)
      install_dir="$2"
      shift 2
      ;;
    --commit)
      commit="$2"
      shift 2
      ;;
    --hermes-home)
      hermes_home="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

[ -n "${install_dir}" ]
[ -n "${commit}" ]
[ -n "${hermes_home}" ]

rm -rf "${install_dir}"
git clone /usr/local/src/hermes-agent-fixture/upstream "${install_dir}"
git -C "${install_dir}" checkout --detach "${commit}"
mkdir -p "${hermes_home}/node/bin" "${install_dir}/node_modules" \
  "${install_dir}/venv/bin" "${install_dir}/plugins/dashboard_auth"
ln -sf /usr/bin/python3 "${install_dir}/venv/bin/python"
touch "${install_dir}/plugins/__init__.py" \
  "${install_dir}/plugins/dashboard_auth/__init__.py"
cat > "${install_dir}/plugins/dashboard_auth/basic.py" <<'PY'
def hash_password(password):
    return "fixture:" + password
PY
mkdir -p "${install_dir}/ui-tui"
printf '%s\n' '{"name":"hermes-tui-fixture"}' > "${install_dir}/ui-tui/package.json"

cat > "${hermes_home}/node/bin/npm" <<'EOF'
#!/bin/sh
set -eu
if [ -f "$PWD/package.json" ]; then
  mkdir -p "$PWD/dist"
  printf '%s\n' 'export default {};' > "$PWD/dist/entry.js"
  id -u > "$PWD/dist/build-uid"
else
  mkdir -p "$PWD/hermes_cli/web_dist"
  printf '%s\n' '<!doctype html><title>Hermes fixture</title>' \
    > "$PWD/hermes_cli/web_dist/index.html"
  id -u > "$PWD/hermes_cli/web_dist/build-uid"
fi
EOF
chmod 0755 "${hermes_home}/node/bin/npm"

cat > /usr/local/bin/hermes <<'EOF'
#!/bin/sh
set -eu

case "${1:-}" in
  --version)
    printf '%s\n' 'Hermes Agent v0.20.0'
    ;;
  tools)
    printf '\342\234\223 enabled  memory\n'
    printf '\342\234\223 enabled  skills\n'
    if [ -e /tmp/hermes-enable-unknown-toolset ]; then
      printf '\342\234\223 enabled  upstream_future_toolset\n'
    fi
    printf '\342\234\227 disabled  bfl\n'
    printf '\342\234\227 disabled  browser\n'
    printf '\342\234\227 disabled  clarify\n'
    printf '\342\234\227 disabled  code_execution\n'
    printf '\342\234\227 disabled  computer_use\n'
    printf '\342\234\227 disabled  context_engine\n'
    printf '\342\234\227 disabled  cronjob\n'
    printf '\342\234\227 disabled  delegation\n'
    printf '\342\234\227 disabled  discord\n'
    printf '\342\234\227 disabled  discord_admin\n'
    printf '\342\234\227 disabled  feishu_doc\n'
    printf '\342\234\227 disabled  feishu_drive\n'
    printf '\342\234\227 disabled  file\n'
    printf '\342\234\227 disabled  homeassistant\n'
    printf '\342\234\227 disabled  image_gen\n'
    printf '\342\234\227 disabled  kanban\n'
    printf '\342\234\227 disabled  project\n'
    printf '\342\234\227 disabled  search\n'
    printf '\342\234\227 disabled  session_search\n'
    printf '\342\234\227 disabled  spotify\n'
    printf '\342\234\227 disabled  stt\n'
    printf '\342\234\227 disabled  terminal\n'
    printf '\342\234\227 disabled  todo\n'
    printf '\342\234\227 disabled  tts\n'
    printf '\342\234\227 disabled  video\n'
    printf '\342\234\227 disabled  video_gen\n'
    printf '\342\234\227 disabled  vision\n'
    printf '\342\234\227 disabled  web\n'
    printf '\342\234\227 disabled  x_search\n'
    printf '\342\234\227 disabled  yuanbao\n'
    ;;
  dashboard)
    host=127.0.0.1
    port=9119
    shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --host)
          host="$2"
          shift 2
          ;;
        --port)
          port="$2"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    exec /usr/bin/python3 -m http.server "$port" --bind "$host"
    ;;
  backup)
    shift
    [ "${1:-}" = "--output" ]
    output_dir="$2"
    mkdir -p "$output_dir"
    : > "$output_dir/hermes-backup-fixture.zip"
    ;;
  *)
    exit 1
    ;;
esac
EOF
chmod 0755 /usr/local/bin/hermes
