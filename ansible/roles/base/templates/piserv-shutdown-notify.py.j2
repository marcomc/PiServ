#!/usr/bin/env python3
from __future__ import annotations

import json
import shlex
import socket
import subprocess
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

RECIPIENT = {{ base_shutdown_notification_recipient | to_json }}
SUBJECT_PREFIX = {{ base_shutdown_notification_subject_prefix | to_json }}
MAIL_CONFIG_PATH = {{ base_shutdown_notification_condition_path | to_json }}
JOURNAL_TIMEOUT_SECONDS = 10
MAIL_TIMEOUT_SECONDS = 20
FIELD_LENGTH_LIMIT = 512

SUDO_COMMAND_DELIMITER = " ; COMMAND="
DIRECT_SHUTDOWN_COMMANDS = {"reboot", "poweroff", "halt", "shutdown"}
TRUSTED_SHUTDOWN_COMMAND_PATHS = {
    "reboot": {"/usr/sbin/reboot", "/usr/bin/reboot", "/sbin/reboot", "/bin/reboot"},
    "poweroff": {"/usr/sbin/poweroff", "/usr/bin/poweroff", "/sbin/poweroff", "/bin/poweroff"},
    "halt": {"/usr/sbin/halt", "/usr/bin/halt", "/sbin/halt", "/bin/halt"},
    "shutdown": {"/usr/sbin/shutdown", "/usr/bin/shutdown", "/sbin/shutdown", "/bin/shutdown"},
    "systemctl": {"/usr/bin/systemctl", "/bin/systemctl"},
}
SYSTEMD_SHUTDOWN_ACTIONS = {
    "reboot",
    "poweroff",
    "halt",
    "kexec",
    "soft-reboot",
}
SYSTEMCTL_MANAGER_OPTIONS = {"--host", "-H", "--machine", "-M"}
SYSTEMCTL_NON_SYSTEM_OPTIONS = {"--user", "--global"}
SYSTEMCTL_OFFLINE_OPTIONS = {"--root", "--image"}
SYSTEMCTL_VALUE_OPTIONS = {
    "--boot-loader-entry",
    "--boot-loader-menu",
    "--boot-loader-menu-timeout",
    "--check-inhibitors",
    "--job-mode",
    "--job-timeout",
    "--job-running-timeout",
    "--kill-whom",
    "--lines",
    "--message",
    "--output",
    "--property",
    "--reboot-argument",
    "--signal",
    "--state",
    "--timestamp",
    "--type",
    "--what",
    "--when",
    "-n",
    "-o",
    "-p",
    "-s",
    "-t",
}
SUDO_EXECUTABLE = "/usr/bin/sudo"
SYSTEMD_SHUTDOWN_TARGETS = {
    "reboot.target",
    "poweroff.target",
    "halt.target",
    "kexec.target",
    "soft-reboot.target",
    "runlevel0.target",
    "runlevel6.target",
    "ctrl-alt-del.target",
}
NON_OPERATIVE_OPTIONS = {
    "shutdown": {"-c", "-k", "--cancel", "--help", "--show", "--version"},
    "reboot": {"-w", "--help", "--version", "--wtmp-only"},
    "poweroff": {"-w", "--help", "--version", "--wtmp-only"},
    "halt": {"-w", "--help", "--version", "--wtmp-only"},
    "systemctl": {"-h", "--dry-run", "--help", "--version"},
}


@dataclass(frozen=True)
class ShutdownRequest:
    requested_at: str
    requested_by: str
    command: str


def safe_field(value: object) -> str:
    normalized = "".join(
        character if character.isprintable() else " " for character in str(value)
    )
    return " ".join(normalized.split())[:FIELD_LENGTH_LIMIT]


def mail_config_available() -> bool:
    try:
        config_path = Path(MAIL_CONFIG_PATH)
        return config_path.is_file() and config_path.stat().st_size > 0
    except OSError:
        return False


def has_nonoperative_option(executable: str, arguments: list[str]) -> bool:
    options = NON_OPERATIVE_OPTIONS[executable]
    for argument in arguments[1:]:
        if argument == "--":
            break
        if argument in options or any(
            argument.startswith(f"{option}=") for option in options if option.startswith("--")
        ):
            return True
        if (
            argument != "--"
            and argument.startswith("--")
            and any(
                option.startswith(argument.partition("=")[0])
                for option in options
                if option.startswith("--")
            )
        ):
            return True
        if (
            executable == "systemctl"
            and argument != "--"
            and "--dry-run".startswith(argument)
        ):
            return True
        if argument.startswith("-") and not argument.startswith("--"):
            if executable == "systemctl" and "h" in argument[1:]:
                return True
            if executable == "shutdown" and any(
                option in argument[1:] for option in {"c", "k"}
            ):
                return True
            if executable in DIRECT_SHUTDOWN_COMMANDS and "w" in argument[1:]:
                return True
    return False


def is_shutdown_cancellation(arguments: list[str]) -> bool:
    for argument in arguments[1:]:
        if argument == "--":
            break
        if argument in {"-c", "--cancel"} or (
            argument != "--"
            and argument.startswith("--")
            and "--cancel".startswith(argument)
        ):
            return True
        if argument.startswith("-") and not argument.startswith("--"):
            if "c" in argument[1:]:
                return True
    return False


def selects_offline_systemd_root(arguments: list[str]) -> bool:
    for argument in arguments[1:]:
        option_name = argument.partition("=")[0]
        if option_name in SYSTEMCTL_OFFLINE_OPTIONS or any(
            option.startswith(option_name)
            for option in SYSTEMCTL_OFFLINE_OPTIONS
            if option_name != "--" and option_name.startswith("--")
        ):
            return True
    return False


def selects_another_systemd_manager(arguments: list[str]) -> bool:
    for argument in arguments[1:]:
        if argument in SYSTEMCTL_MANAGER_OPTIONS:
            return True
        if argument.startswith(("--host=", "--machine=")):
            return True
        if (
            argument != "--"
            and argument.startswith("--")
            and any(
                option.startswith(argument.partition("=")[0])
                for option in {"--host", "--machine"}
            )
        ):
            return True
        if argument.startswith(("-H", "-M")) and argument not in {"-H", "-M"}:
            return True
    return False


def selects_non_system_systemd_manager(arguments: list[str]) -> bool:
    for argument in arguments[1:]:
        option_name = argument.partition("=")[0]
        if option_name in SYSTEMCTL_NON_SYSTEM_OPTIONS or any(
            option.startswith(option_name)
            for option in SYSTEMCTL_NON_SYSTEM_OPTIONS
            if option_name != "--" and option_name.startswith("--")
        ):
            return True
    return False


def systemctl_when_mode(arguments: list[str]) -> str | None:
    for index, argument in enumerate(arguments[1:], start=1):
        option_name, separator, option_value = argument.partition("=")
        if (
            option_name != "--"
            and "--when".startswith(option_name)
            and option_name.startswith("--")
        ):
            if separator:
                return option_value
            if index + 1 < len(arguments):
                return arguments[index + 1]
        if argument == "--when" and index + 1 < len(arguments):
            return arguments[index + 1]
    return None


def systemctl_operands(arguments: list[str]) -> list[str]:
    operands: list[str] = []
    skip_next = False
    options_ended = False
    for argument in arguments[1:]:
        if skip_next:
            skip_next = False
            continue
        if argument == "--":
            options_ended = True
            continue
        if options_ended:
            operands.append(argument)
            continue
        if argument in SYSTEMCTL_VALUE_OPTIONS or (
            argument != "--"
            and argument.startswith("--")
            and any(
                option.startswith(argument)
                for option in SYSTEMCTL_VALUE_OPTIONS
                if option.startswith("--")
            )
        ):
            skip_next = True
            continue
        if not argument.startswith("-"):
            operands.append(argument)
    return operands


def is_sudo_journal_record(record: dict[str, object]) -> bool:
    return (
        record.get("_COMM") == "sudo"
        and record.get("_EXE") == SUDO_EXECUTABLE
    )


def shutdown_command_kind(command: str) -> str | None:
    """Classify a sudo command as an operation, cancellation, or neither."""
    try:
        arguments = shlex.split(command)
    except ValueError:
        return None
    if not arguments:
        return None

    executable_path = arguments[0]
    executable = executable_path.rsplit("/", maxsplit=1)[-1]
    if executable_path not in TRUSTED_SHUTDOWN_COMMAND_PATHS.get(executable, set()):
        return None
    if executable in DIRECT_SHUTDOWN_COMMANDS:
        if executable == "shutdown" and is_shutdown_cancellation(arguments):
            return "cancellation"
        return (
            "operation"
            if not has_nonoperative_option(executable, arguments)
            else None
        )
    if executable != "systemctl":
        return None
    if (
        has_nonoperative_option(executable, arguments)
        or selects_another_systemd_manager(arguments)
        or selects_offline_systemd_root(arguments)
        or selects_non_system_systemd_manager(arguments)
    ):
        return None
    when_mode = systemctl_when_mode(arguments)
    if when_mode == "cancel":
        return "cancellation"
    if when_mode == "show":
        return None
    operands = systemctl_operands(arguments)
    if not operands:
        return None
    if operands[0] in SYSTEMD_SHUTDOWN_ACTIONS:
        return "operation"
    if operands[0] in {"start", "restart", "reload-or-restart", "force-reload"} and any(
        operand in SYSTEMD_SHUTDOWN_TARGETS for operand in operands[1:]
    ):
        return "operation"
    if (
        operands[0] == "isolate"
        and len(operands) > 1
        and operands[1] in SYSTEMD_SHUTDOWN_TARGETS
    ):
        return "operation"
    return None


def is_shutdown_command(command: str) -> bool:
    return shutdown_command_kind(command) == "operation"


def system_state() -> str:
    try:
        result = subprocess.run(
            ["/usr/bin/systemctl", "is-system-running"],
            capture_output=True,
            text=True,
            check=False,
            timeout=JOURNAL_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    return result.stdout.strip() or "unknown"


def shutdown_in_progress() -> bool:
    return system_state() in {"stopping", "offline"}


def journal_records(identifier: str) -> list[dict[str, object]]:
    try:
        result = subprocess.run(
            [
                "/usr/bin/journalctl",
                "--boot=0",
                "--identifier",
                identifier,
                "--no-pager",
                "--output=json",
            ],
            capture_output=True,
            text=True,
            check=False,
            timeout=JOURNAL_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []

    if result.returncode != 0:
        return []

    records: list[dict[str, object]] = []
    for line in result.stdout.splitlines():
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(record, dict):
            records.append(record)
    return records


def journal_timestamp_value(record: dict[str, object]) -> int | None:
    for field_name in ("_SOURCE_REALTIME_TIMESTAMP", "__REALTIME_TIMESTAMP"):
        try:
            return int(str(record.get(field_name)))
        except (TypeError, ValueError):
            continue
    return None


def journal_sequence_value(record: dict[str, object]) -> int | None:
    try:
        return int(str(record.get("__MONOTONIC_TIMESTAMP")))
    except (TypeError, ValueError):
        return None


def journal_timestamp(record: dict[str, object]) -> str:
    timestamp = journal_timestamp_value(record)
    if timestamp is None:
        return "unknown"
    timestamp_seconds = timestamp / 1_000_000
    return datetime.fromtimestamp(timestamp_seconds, timezone.utc).isoformat(
        timespec="seconds"
    )


def latest_sudo_shutdown_request(
    records: list[dict[str, object]],
) -> ShutdownRequest | None:
    latest_request: ShutdownRequest | None = None
    chronological_records = list(enumerate(records))
    if all(journal_sequence_value(record) is not None for record in records):
        chronological_records.sort(
            key=lambda indexed_record: journal_sequence_value(indexed_record[1]) or 0
        )
    for _, record in chronological_records:
        if not is_sudo_journal_record(record):
            continue
        message = record.get("MESSAGE")
        if not isinstance(message, str):
            continue
        prefix, separator, command = message.partition(SUDO_COMMAND_DELIMITER)
        if not separator:
            continue
        requested_by, separator, _ = prefix.partition(":")
        if not separator:
            continue
        command_kind = shutdown_command_kind(command)
        if command_kind is None:
            continue
        if command_kind == "cancellation":
            latest_request = None
            continue
        latest_request = ShutdownRequest(
            requested_at=journal_timestamp(record),
            requested_by=safe_field(requested_by),
            command=safe_field(command),
        )

    return latest_request


def shutdown_request() -> ShutdownRequest | None:
    return latest_sudo_shutdown_request(journal_records("sudo"))


def notification_payload(hostname: str, request: ShutdownRequest | None) -> str:
    notification_time = datetime.now(timezone.utc).isoformat(timespec="seconds")
    hostname = safe_field(hostname)
    subject = f"{safe_field(SUBJECT_PREFIX)} shutting down: {hostname}"
    if request is None:
        requested_at = "unknown"
        requested_by = "unknown"
        command = "unknown"
        evidence = "No matching sudo shutdown command was retained for this boot."
    else:
        requested_at = safe_field(request.requested_at)
        requested_by = safe_field(request.requested_by)
        command = safe_field(request.command)
        evidence = "Latest matching sudo journal record from the current boot."

    return "\n".join(
        [
            f"To: {RECIPIENT}",
            f"Subject: {subject}",
            "",
            f"Host: {hostname}",
            f"Shutdown notification time (UTC): {notification_time}",
            f"Shutdown request time (UTC): {requested_at}",
            f"Requested by: {requested_by}",
            f"Command: {command}",
            f"Evidence: {evidence}",
            "",
        ]
    )


def main() -> int:
    if not mail_config_available() or not shutdown_in_progress():
        return 0

    hostname = socket.getfqdn() or socket.gethostname()
    payload = notification_payload(hostname, shutdown_request())
    subprocess.run(
        ["/usr/sbin/sendmail", "-t"],
        input=payload,
        text=True,
        check=True,
        timeout=MAIL_TIMEOUT_SECONDS,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
