# Managed by PiServ base role. Do not edit on the host.
[Unit]
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=
# -u loads the existing salted hash for this username without an interactive prompt.
# Do not use --password here: it prompts when the managed password file is absent.
ExecStart=/usr/bin/glances --webserver --disable-webui --bind {{ base_glances_bind_address }} --port {{ base_glances_port }} -u {{ base_glances_auth_username }}
Restart=on-failure
RestartSec=5s
DynamicUser=yes
StateDirectory={{ base_glances_state_directory }}
RuntimeDirectory={{ base_glances_runtime_directory }}
Environment=HOME=/var/lib/{{ base_glances_state_directory }}
WorkingDirectory=/var/lib/{{ base_glances_state_directory }}
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
