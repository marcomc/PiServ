[Unit]
Description=Send PiServ boot notification email
Wants=network-online.target
After=network-online.target
ConditionPathExists={{ base_reboot_notification_condition_path }}

[Service]
Type=oneshot
ExecCondition=/usr/bin/test -s {{ base_reboot_notification_condition_path | quote }}
ExecStart={{ base_reboot_notification_script_path }}
TimeoutStartSec={{ ((base_reboot_notification_retry_attempts * base_reboot_notification_delivery_timeout_seconds) + ((base_reboot_notification_retry_attempts - 1) * base_reboot_notification_retry_delay_seconds) + 10) }}s

[Install]
WantedBy=multi-user.target
