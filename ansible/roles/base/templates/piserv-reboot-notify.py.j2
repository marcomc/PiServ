#!/usr/bin/env python3
from __future__ import annotations

import platform
import socket
import subprocess
from datetime import datetime, timedelta, timezone

RECIPIENT = {{ base_reboot_notification_recipient | to_json }}
SUBJECT_PREFIX = {{ base_reboot_notification_subject_prefix | to_json }}


def boot_time() -> str:
    try:
        uptime_seconds = float(open("/proc/uptime", encoding="utf-8").read().split()[0])
    except (OSError, IndexError, ValueError):
        return "unknown"
    booted_at = datetime.now(timezone.utc) - timedelta(seconds=uptime_seconds)
    return booted_at.isoformat(timespec="seconds")


def main() -> int:
    hostname = socket.getfqdn() or socket.gethostname()
    subject = f"{SUBJECT_PREFIX} booted: {hostname}"
    payload = "\n".join(
        [
            f"To: {RECIPIENT}",
            f"Subject: {subject}",
            "",
            f"Host: {hostname}",
            f"Boot time: {boot_time()}",
            f"Kernel: {platform.platform()}",
            "",
        ]
    )
    subprocess.run(["/usr/sbin/sendmail", "-t"], input=payload, text=True, check=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
