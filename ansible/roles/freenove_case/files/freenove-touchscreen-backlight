#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: $(basename "$0") BACKLIGHT_DEVICE BRIGHTNESS" >&2
  exit 2
fi

backlight_device="$1"
requested="$2"
brightness_file="${backlight_device}/brightness"
max_brightness_file="${backlight_device}/max_brightness"

case "${requested}" in
  '' | *[!0-9]*)
    echo "brightness must be an integer" >&2
    exit 2
    ;;
  *)
    ;;
esac

if [ ! -w "${brightness_file}" ]; then
  echo "brightness file is not writable: ${brightness_file}" >&2
  exit 1
fi

max_brightness="$(cat "${max_brightness_file}")"

if [ "${requested}" -gt "${max_brightness}" ]; then
  requested="${max_brightness}"
fi

printf '%s\n' "${requested}" > "${brightness_file}"
