#!/usr/bin/env bash
set -euo pipefail

readonly helper_path={{ cgroup_memory_controller_helper_path | quote }}

if [[ ! -x "${helper_path}" ]]; then
  printf 'The cgroup memory-controller refresh helper is unavailable: %s\n' \
    "${helper_path}" >&2
  exit 1
fi

if ! result="$("${helper_path}" --apply 2>&1)"; then
  printf '%s\n' "${result}" >&2
  if rollback_result="$("${helper_path}" --disable 2>&1)"; then
    printf '%s\n' "${rollback_result}" >&2
    printf '%s\n' \
      'The managed cgroup memory Device Tree was disabled after regeneration failed.' >&2
  else
    printf '%s\n' "${rollback_result}" >&2
    printf '%s\n' \
      'The managed cgroup memory Device Tree could not be disabled after regeneration failed.' >&2
  fi
  exit 1
fi

printf '%s\n' "${result}" >&2
