#!/usr/bin/env bash
set -euo pipefail

source_dtb={{ cgroup_memory_controller_vendor_dtb | quote }}
config_path={{ cgroup_memory_controller_config_path | quote }}
overlay_path={{ cgroup_memory_controller_overlay_path | quote }}
disabled_argument={{ cgroup_memory_controller_disabled_argument | quote }}

readonly source_dtb config_path overlay_path disabled_argument
readonly fdtget_binary=/usr/bin/fdtget
readonly fdtoverlay_binary=/usr/bin/fdtoverlay
readonly dtc_binary=/usr/bin/dtc
readonly begin_marker={{ ('# BEGIN ' ~ cgroup_memory_controller_config_marker) | quote }}
readonly end_marker={{ ('# END ' ~ cgroup_memory_controller_config_marker) | quote }}

work_directory=''
source_bootargs=''
replacement_bootargs=''
controller_status=''
candidate_overlay_path=''

usage() {
  printf 'Usage: %s --check|--apply|--disable\n' "$0" >&2
}

cleanup() {
  if [[ -n "${work_directory}" && -d "${work_directory}" ]]; then
    rm -rf -- "${work_directory}"
  fi
}

fail() {
  printf 'cgroup memory controller: %s\n' "$*" >&2
  exit 1
}

require_regular_file() {
  local file_path="$1"

  [[ -f "${file_path}" && ! -L "${file_path}" ]] || \
    fail "expected regular file at ${file_path}"
}

require_command() {
  local command_path="$1"

  [[ -x "${command_path}" ]] || fail "required command is unavailable: ${command_path}"
}

print_status() {
  local changed="$1"
  local source_sha256

  source_sha256="$(sha256sum "${source_dtb}" | awk '{print $1}')"
  printf 'status=%s\n' "${controller_status}"
  printf 'changed=%s\n' "${changed}"
  printf 'source_dtb_sha256=%s\n' "${source_sha256}"
}

inspect_source_bootargs() {
  local argument
  local disabled_argument_count=0
  local replacement_argument_count=0
  local -a source_arguments
  local -a replacement_arguments

  require_regular_file "${source_dtb}"
  require_command "${fdtget_binary}"

  source_bootargs="$("${fdtget_binary}" --type s "${source_dtb}" /chosen bootargs)"
  [[ -n "${source_bootargs}" ]] || fail "vendor DTB has an empty /chosen/bootargs property"
  [[ "${source_bootargs}" != *$'\n'* ]] || fail "vendor boot arguments contain a newline"

  read -r -a source_arguments <<< "${source_bootargs}"
  for argument in "${source_arguments[@]}"; do
    if [[ "${argument}" == "${disabled_argument}" ]]; then
      ((disabled_argument_count += 1))
    else
      replacement_arguments+=("${argument}")
      ((replacement_argument_count += 1))
    fi
  done

  case "${disabled_argument_count}" in
    0)
      controller_status='vendor-enabled'
      replacement_bootargs="${source_bootargs}"
      return
      ;;
    1)
      controller_status='overlay-required'
      ;;
    *)
      fail "vendor boot arguments contain ${disabled_argument_count} copies of ${disabled_argument}"
      ;;
  esac

  ((replacement_argument_count > 0)) || \
    fail "removing ${disabled_argument} would leave /chosen/bootargs empty"
  replacement_bootargs="${replacement_arguments[*]}"
}

prepare_overlay() {
  local escaped_bootargs
  local merged_dtb
  local merged_bootargs

  [[ "${controller_status}" == 'overlay-required' ]] || \
    fail 'cannot prepare an overlay when the vendor already enables memory cgroups'
  require_command "${fdtoverlay_binary}"
  require_command "${dtc_binary}"

  work_directory="$(mktemp -d /run/cgroup-memory-controller.XXXXXX)"
  chmod 0700 "${work_directory}"
  candidate_overlay_path="${work_directory}/cgroup-memory.dtbo"
  merged_dtb="${work_directory}/merged.dtb"
  escaped_bootargs="$(printf '%s' "${replacement_bootargs}" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g')"

  cat > "${work_directory}/cgroup-memory-overlay.dts" <<EOF
/dts-v1/;
/plugin/;

/ {
  fragment@0 {
    target-path = "/chosen";

    __overlay__ {
      bootargs = "${escaped_bootargs}";
    };
  };
};
EOF

  "${dtc_binary}" -@ -I dts -O dtb -o "${candidate_overlay_path}" \
    "${work_directory}/cgroup-memory-overlay.dts"
  "${fdtoverlay_binary}" -i "${source_dtb}" -o "${merged_dtb}" "${candidate_overlay_path}"
  merged_bootargs="$("${fdtget_binary}" --type s "${merged_dtb}" /chosen bootargs)"
  [[ "${merged_bootargs}" == "${replacement_bootargs}" ]] || \
    fail 'offline Device Tree merge did not preserve the expected boot arguments'
  [[ " ${merged_bootargs} " != *" ${disabled_argument} "* ]] || \
    fail "offline Device Tree merge retained ${disabled_argument}"
}

disable_managed_overlay() {
  local begin_count
  local end_count
  local config_temp
  local changed=false

  require_regular_file "${config_path}"
  begin_count="$(grep -Fxc "${begin_marker}" "${config_path}" || true)"
  end_count="$(grep -Fxc "${end_marker}" "${config_path}" || true)"
  [[ "${begin_count}" == "${end_count}" ]] || \
    fail 'managed config markers are incomplete; refusing to edit firmware configuration'
  [[ "${begin_count}" -le 1 ]] || \
    fail 'managed config markers are duplicated; refusing to edit firmware configuration'

  if [[ "${begin_count}" == '1' ]]; then
    config_temp="$(mktemp "${config_path}.cgroup-memory-controller.XXXXXX")"
    awk -v begin="${begin_marker}" -v end="${end_marker}" '
      $0 == begin { inside = 1; next }
      $0 == end { inside = 0; next }
      !inside { print }
    ' "${config_path}" > "${config_temp}"
    if ! cmp -s "${config_temp}" "${config_path}"; then
      mv -f -- "${config_temp}" "${config_path}"
      changed=true
    else
      rm -f -- "${config_temp}"
    fi
  fi

  if [[ -e "${overlay_path}" ]]; then
    [[ -f "${overlay_path}" && ! -L "${overlay_path}" ]] || \
      fail "managed overlay path is not a regular file: ${overlay_path}"
    rm -f -- "${overlay_path}"
    changed=true
  fi

  if [[ "${changed}" == true ]]; then
    sync -f "${config_path}"
  fi
  printf 'status=disabled\n'
  printf 'changed=%s\n' "${changed}"
}

main() {
  local mode="${1:-}"
  local candidate_overlay
  local changed=false

  [[ $# -eq 1 ]] || {
    usage
    exit 2
  }
  trap cleanup EXIT

  case "${mode}" in
    --disable)
      disable_managed_overlay
      return
      ;;
    --check|--apply)
      ;;
    *)
      usage
      exit 2
      ;;
  esac

  inspect_source_bootargs
  if [[ "${controller_status}" == 'vendor-enabled' ]]; then
    print_status false
    return
  fi

  prepare_overlay
  candidate_overlay="${candidate_overlay_path}"
  if [[ -f "${overlay_path}" ]] && cmp -s "${candidate_overlay}" "${overlay_path}"; then
    print_status false
    return
  fi

  changed=true
  if [[ "${mode}" == '--apply' ]]; then
    install -m 0644 "${candidate_overlay}" "${overlay_path}"
    sync -f "${overlay_path}"
  fi
  print_status "${changed}"
}

main "$@"
