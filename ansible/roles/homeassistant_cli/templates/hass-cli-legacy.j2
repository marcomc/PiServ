#!/bin/sh
set -eu

token_file={{ homeassistant_cli_token_env_file | quote }}
if [ ! -r "${token_file}" ]; then
    printf '%s\n' 'Home Assistant CLI token file is not readable.' >&2
    exit 1
fi

token_name={{ homeassistant_cli_token_env_var | quote }}
if ! token_value=$(awk -v token_name="${token_name}" '
    index($0, token_name "=") == 1 {
        token_count += 1
        token_value = substr($0, length(token_name) + 2)
    }
    END {
        if (token_count != 1 || token_value == "") {
            exit 1
        }
        print token_value
    }
' "${token_file}"); then
    printf '%s\n' 'Home Assistant token is missing, ambiguous, or empty.' >&2
    exit 1
fi

export HASS_SERVER={{ homeassistant_cli_server | quote }}
export HASS_TOKEN="${token_value}"
exec {{ homeassistant_cli_binary_path | quote }} "$@"
