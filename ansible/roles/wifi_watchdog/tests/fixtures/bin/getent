#!/usr/bin/env sh

: "${WIFI_WATCHDOG_TEST_LOG:?WIFI_WATCHDOG_TEST_LOG must be set}"

case "$*" in
    'ahostsv4 example.com')
        printf '%s\n' "getent $*" >> "${WIFI_WATCHDOG_TEST_LOG}"
        printf '%s\n' '203.0.113.1 STREAM example.com'
        ;;
    *)
        printf 'unexpected getent invocation: %s\n' "$*" >&2
        exit 1
        ;;
esac
