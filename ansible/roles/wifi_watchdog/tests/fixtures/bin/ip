#!/usr/bin/env sh

: "${WIFI_WATCHDOG_TEST_LOG:?WIFI_WATCHDOG_TEST_LOG must be set}"

case "$*" in
    '-4 route show default dev wlan0')
        printf '%s\n' "ip $*" >> "${WIFI_WATCHDOG_TEST_LOG}"
        printf '%s\n' 'default via 192.0.2.1 dev wlan0 proto dhcp metric 600'
        ;;
    *)
        printf 'unexpected ip invocation: %s\n' "$*" >&2
        exit 1
        ;;
esac
