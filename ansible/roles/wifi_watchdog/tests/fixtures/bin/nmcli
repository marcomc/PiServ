#!/usr/bin/env sh

: "${WIFI_WATCHDOG_TEST_LOG:?WIFI_WATCHDOG_TEST_LOG must be set}"

case "$*" in
    '-t -f DEVICE,STATE device status')
        printf '%s\n' "device status locale=${LC_ALL:-unset}" >> "${WIFI_WATCHDOG_TEST_LOG}"
        printf '%s\n' "${WIFI_WATCHDOG_TEST_DEVICE_STATUS:-wlan0:disconnected}"
        ;;
    'device disconnect wlan0'|'device connect wlan0')
        printf '%s\n' "$*" >> "${WIFI_WATCHDOG_TEST_LOG}"
        ;;
    *)
        printf 'unexpected nmcli invocation: %s\n' "$*" >&2
        exit 1
        ;;
esac
