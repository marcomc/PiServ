#!/usr/bin/env sh

: "${WIFI_WATCHDOG_TEST_LOG:?WIFI_WATCHDOG_TEST_LOG must be set}"

case "$*" in
    '-I wlan0 -c 1 -W 2 192.0.2.1')
        printf '%s\n' "ping $*" >> "${WIFI_WATCHDOG_TEST_LOG}"
        ;;
    *)
        printf 'unexpected ping invocation: %s\n' "$*" >&2
        exit 1
        ;;
esac
