#!/bin/sh
set -eu

iptables=/usr/sbin/iptables
iptables_restore=/usr/sbin/iptables-restore
port={{ piserv_jackett_port }}
lan_ipv4_cidr={{ piserv_jackett_lan_ipv4_cidr }}
chain={{ piserv_jackett_docker_firewall_chain }}
comment='PiServ Jackett Search Docker ingress'

ensure_chain() {
  if ! "${iptables}" -n -L "${chain}" >/dev/null 2>&1; then
    "${iptables}" -N "${chain}"
  fi
}

delete_docker_user_rule() {
  while "${iptables}" -C DOCKER-USER "$@" >/dev/null 2>&1; do
    "${iptables}" -D DOCKER-USER "$@"
  done
}

# Docker DNAT runs before UFW INPUT rules. Keep all Jackett Search-specific rules in
# an isolated chain, so reruns replace a changed LAN CIDR without touching
# unrelated DOCKER-USER policy.
ensure_chain
# Rebuild the chain in one filter-table transaction while the existing hook
# remains active, avoiding an empty-chain ingress window during updates.
"${iptables_restore}" --noflush <<EOF
*filter
-F ${chain}
-A ${chain} -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
-A ${chain} -i tailscale0 -m conntrack --ctstate NEW -j ACCEPT
-A ${chain} -s ${lan_ipv4_cidr} -m conntrack --ctstate NEW -j ACCEPT
-A ${chain} -j DROP
COMMIT
EOF

# Keep the managed hook ahead of Docker's accept rules. `--ctstate DNAT` limits
# it to traffic Docker published to the container, so container egress to a
# remote TCP 9117 does not enter this chain while every published ingress path
# remains subject to the source allowlist and terminal drop.
#
# Replace the exact managed hook on every run before installing the current
# DNAT-scoped policy.
delete_docker_user_rule \
  -p tcp -m conntrack --ctorigdstport "${port}" \
  -m comment --comment "${comment}" -j "${chain}"
delete_docker_user_rule \
  -p tcp -m conntrack --ctstate DNAT --ctorigdstport "${port}" \
  -m comment --comment "${comment}" -j "${chain}"
"${iptables}" -I DOCKER-USER 1 \
  -p tcp -m conntrack --ctstate DNAT --ctorigdstport "${port}" \
  -m comment --comment "${comment}" -j "${chain}"
