---
# Copy to hermes-agent.yml, which is ignored because it may contain a personal
# local Home Assistant address. The access token stays only on PiServ in
# /var/lib/hermes-agent/home-assistant-mcp.env.
piserv_hermes_agent_manage_home_assistant_mcp: false
piserv_hermes_agent_home_assistant_mcp_url: ""
# Set these values to expose the dashboard through the PiServ firewall policy.
# The password itself is generated once on PiServ and stored root-only.
piserv_hermes_agent_dashboard_host: 127.0.0.1
piserv_hermes_agent_dashboard_manage_basic_auth: false
piserv_hermes_agent_dashboard_basic_auth_username: ""

# Enable a dedicated SSH account that can only start `hermes mcp serve` through
# an sshd-enforced forced command. It is enabled by default and the account
# never receives a password.
piserv_hermes_mcp_ssh_manage: true
piserv_hermes_mcp_ssh_user: codex-hermes-mcp
piserv_hermes_mcp_ssh_group: codex-hermes-mcp
piserv_hermes_mcp_ssh_home: /var/lib/codex-hermes-mcp
piserv_hermes_mcp_ssh_authorized_keys_path: >-
  /var/lib/codex-hermes-mcp/.ssh/authorized_keys
piserv_hermes_mcp_ssh_wrapper_path: >-
  /usr/local/libexec/hermes-agent/codex-mcp-ssh
piserv_hermes_mcp_ssh_wrapper_template: hermes-mcp-ssh-wrapper.sh.j2
piserv_hermes_mcp_ssh_sudoers_path: /etc/sudoers.d/codex-hermes-mcp
piserv_hermes_mcp_ssh_sshd_config_path: >-
  /etc/ssh/sshd_config.d/60-codex-hermes-mcp.conf
piserv_hermes_mcp_ssh_state_path: >-
  /usr/local/libexec/hermes-agent/.codex-hermes-mcp-state.json
piserv_hermes_mcp_ssh_trusted_preceding_match_configs: []

# When false, the first managed run creates an empty authorized_keys file and
# never changes it again; install operator-selected public keys manually. The
# sshd policy still enforces the fixed MCP command. When true, every run copies
# admin's plain, currently authorized public keys and restricts each one too.
piserv_hermes_mcp_ssh_copy_admin_authorized_keys: true
piserv_hermes_mcp_ssh_source_user: admin
piserv_hermes_mcp_ssh_source_authorized_keys_path: >-
  /home/admin/.ssh/authorized_keys

# Enable a second no-shell SSH principal for bounded Hermes agent turns. It
# intentionally shares Hermes's configured capabilities, including enabled
# Home Assistant writes; Home Assistant exposure and credentials are the
# capability boundary.
piserv_hermes_delegation_mcp_ssh_manage: true
piserv_hermes_delegation_mcp_ssh_user: codex-hermes-delegate
piserv_hermes_delegation_mcp_ssh_group: codex-hermes-delegate
piserv_hermes_delegation_mcp_ssh_home: /var/lib/codex-hermes-delegate
piserv_hermes_delegation_mcp_ssh_authorized_keys_path: >-
  /var/lib/codex-hermes-delegate/.ssh/authorized_keys
piserv_hermes_delegation_mcp_ssh_wrapper_path: >-
  /usr/local/libexec/hermes-agent/codex-delegation-mcp-ssh
piserv_hermes_delegation_mcp_ssh_sudoers_path: >-
  /etc/sudoers.d/codex-hermes-delegate
piserv_hermes_delegation_mcp_ssh_sshd_config_path: >-
  /etc/ssh/sshd_config.d/61-codex-hermes-delegate.conf
piserv_hermes_delegation_mcp_ssh_state_path: >-
  /usr/local/libexec/hermes-agent/.codex-hermes-delegation-mcp-state.json
piserv_hermes_delegation_mcp_ssh_trusted_preceding_match_configs:
  - path: /etc/ssh/sshd_config.d/60-codex-hermes-mcp.conf
    user: codex-hermes-mcp
    authorized_keys_path: /var/lib/codex-hermes-mcp/.ssh/authorized_keys
    wrapper_path: /usr/local/libexec/hermes-agent/codex-mcp-ssh
piserv_hermes_delegation_mcp_ssh_copy_admin_authorized_keys: true
piserv_hermes_delegation_mcp_ssh_source_user: admin
piserv_hermes_delegation_mcp_ssh_source_authorized_keys_path: >-
  /home/admin/.ssh/authorized_keys
piserv_hermes_delegation_mcp_adapter_path: >-
  /usr/local/libexec/hermes-agent/hermes-delegation-mcp.py
piserv_hermes_delegation_mcp_python_path: >-
  /usr/local/lib/hermes-agent/venv/bin/python
piserv_hermes_delegation_mcp_timeout_seconds: 300
piserv_hermes_delegation_mcp_terminate_grace_seconds: 5
piserv_hermes_delegation_mcp_max_prompt_bytes: 32768
piserv_hermes_delegation_mcp_max_output_bytes: 1048576
piserv_hermes_delegation_mcp_max_turns: 50
piserv_hermes_delegation_mcp_config_path: >-
  /usr/local/lib/hermes-agent/.hermes-delegation-config.yaml
piserv_hermes_delegation_mcp_native_toolsets:
  - delegation
  - file
  - memory
  - session_search
  - skills
  - terminal
  - todo
piserv_hermes_delegation_mcp_integration_toolsets: >-
  {{ [piserv_hermes_agent_home_assistant_mcp_name]
  if (piserv_hermes_agent_manage_home_assistant_mcp | bool) else [] }}
